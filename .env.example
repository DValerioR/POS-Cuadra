DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/pos

# Opcionales (estos son los valores por defecto):
# HORAS_SESION=12
# COOKIE_SEGURA=false            # true solo si se sirve por HTTPS
# ZONA_HORARIA=America/Mexico_City
# NEGOCIO_PREDETERMINADO=1       # el que usa la pantalla de inicio de sesión
# TOPE_IA_MES=300                # usos de IA al mes del plan de Cuadra (vacío = sin tope)
# TOPE_FACTURAS_MES=150          # facturas reales al mes del plan (vacío = sin tope)
